def show(*sal,**info):
    for i in sal:
        total=0
        total=total+i
    print("salary is",total)
    print("Name is ",info["Name"])
    print("Age is ",info["age"])
    print("Company is ",info["Company"])

show(sal=(10000,20000,30000,40000,50000),info={"Name":"Sujal","Age":20,"Company":"Amazon"}
    )